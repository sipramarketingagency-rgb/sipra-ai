  <!-- INVITE MODAL -->
  <div id="inviteModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" onclick="closeInviteModal()"></div>
    <div class="relative w-full max-w-md rounded-2xl bg-zinc-900 border border-zinc-800 shadow-2xl p-6">
      <div class="flex items-center justify-between mb-6"><h3 class="text-sm font-semibold text-white">Invite Client User</h3><button onclick="closeInviteModal()" class="w-7 h-7 rounded-lg bg-zinc-800 flex items-center justify-center text-zinc-400">✕</button></div>
      <div class="space-y-4">
        <div><label class="text-[11px] font-mono text-zinc-500 uppercase">Email</label><input id="inviteEmail" placeholder="client@agency.com" class="w-full mt-1 px-3 py-2.5 rounded-xl bg-zinc-950 border border-zinc-800 text-sm text-white outline-none focus:border-indigo-500"/></div>
        <div class="grid grid-cols-2 gap-3"><div><label class="text-[11px] font-mono text-zinc-500 uppercase">Role</label><select id="inviteRole" class="w-full mt-1 px-3 py-2.5 rounded-xl bg-zinc-950 border border-zinc-800 text-sm text-white"><option value="client_user">Client User</option><option value="client_admin">Client Admin</option><option value="agency_owner">Agency Owner</option></select></div><div><label class="text-[11px] font-mono text-zinc-500 uppercase">Tenant</label><select id="inviteTenant" class="w-full mt-1 px-3 py-2.5 rounded-xl bg-zinc-950 border border-zinc-800 text-sm text-white"></select></div></div>
        <button onclick="sendInvite()" class="w-full py-3 rounded-xl bg-indigo-600 text-white text-sm font-semibold">Send Invite → /invite/:token</button>
        <div class="text-[11px] text-zinc-500">Creates invitation with token, 7-day expiry, status pending. User registers via /invite/:token link, auto-assigned client_id and role.</div>
      </div>
    </div>
  </div>

  <!-- COMMAND PALETTE -->
  <div id="commandPalette" class="hidden fixed inset-0 z-50 flex items-start justify-center pt-[20vh] px-4">
    <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" onclick="closeSearch()"></div>
    <div class="relative w-full max-w-lg rounded-2xl bg-zinc-900 border border-zinc-800 shadow-2xl overflow-hidden">
      <div class="flex items-center gap-3 px-4 h-14 border-b border-zinc-800">
        <svg class="w-4 h-4 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input id="searchInput" type="text" placeholder="Ask your AI workforce or jump to..." class="flex-1 bg-transparent text-sm text-white placeholder:text-zinc-500 outline-none" oninput="handleSearch(this.value)"/>
        <span class="px-1.5 py-0.5 rounded bg-zinc-800 border border-zinc-700 text-[10px] font-mono text-zinc-400">ESC</span>
      </div>
      <div class="p-2 max-h-80 overflow-y-auto" id="searchResults"></div>
    </div>
  </div>

  <script>
    let currentUser = null;
    let currentTenant = null; // selected tenant object
    let allTenants = [];
    let allEmployees = [];
    let authToken = localStorage.getItem('sipra_token') || null;
    let inviteTokenFromUrl = null;

    // Check URL for /portal/:slug or /invite/:token or ?tenant=
    function parseUrl(){
      const path = window.location.pathname;
      const params = new URLSearchParams(window.location.search);
      // portal
      const portalMatch = path.match(/\/portal\/([^\/]+)/);
      if(portalMatch){
        const slug = portalMatch[1];
        params.set('tenant', slug);
        window.history.replaceState({}, '', `/?tenant=${slug}&portal=${slug}`);
        return slug;
      }
      const inviteMatch = path.match(/\/invite\/([^\/]+)/);
      if(inviteMatch){
        inviteTokenFromUrl = inviteMatch[1];
        // will show register with invite info
        setTimeout(()=>openAuth('register'), 500);
        fetchInviteInfo(inviteTokenFromUrl);
        return null;
      }
      return params.get('tenant') || params.get('client') || params.get('portal') || null;
    }

    async function fetchInviteInfo(token){
      const res = await fetch(`/api/invite/${token}`);
      const data = await res.json();
      const el = document.getElementById('inviteInfo');
      if(res.ok){
        el.classList.remove('hidden');
        el.innerHTML = `📩 Invited to <b>${data.client_name}</b> as <b>${data.role}</b> · Email must be <b>${data.email}</b> · Expires ${new Date(data.expires_at).toLocaleDateString()}<br/><span class="text-[11px] text-zinc-400">Token: ${token.slice(0,12)}...</span>`;
        document.getElementById('regEmail').value = data.email;
        document.getElementById('regEmail').disabled = true;
      } else {
        el.classList.remove('hidden');
        el.classList.add('bg-red-950/30','border-red-900/50','text-red-200');
        el.textContent = data.error || 'Invalid invitation';
      }
    }

    function getHeaders(){
      const h = {'Content-Type':'application/json'};
      if(authToken) h['Authorization'] = `Bearer ${authToken}`;
      if(currentTenant) h['X-Tenant-Slug'] = currentTenant.slug;
      return h;
    }

    async function fetchJSON(url, opts={}){
      try{
        opts.headers = {...getHeaders(), ...(opts.headers||{})};
        opts.credentials = 'include';
        const r = await fetch(url, opts);
        if(r.status===401){
          // auth required
          openAuth('login');
          return null;
        }
        return await r.json();
      }catch(e){console.error(e); return null}
    }

    // AUTH
    function openAuth(tab='login'){
      document.getElementById('authModal').classList.remove('hidden');
      switchAuthTab(tab);
    }
    function closeAuth(){document.getElementById('authModal').classList.add('hidden');}
    function switchAuthTab(tab){
      document.getElementById('authTabLogin').className = tab==='login' ? 'flex-1 py-2.5 rounded-lg bg-zinc-800 text-white text-sm font-medium' : 'flex-1 py-2.5 rounded-lg text-zinc-400 text-sm font-medium';
      document.getElementById('authTabRegister').className = tab==='register' ? 'flex-1 py-2.5 rounded-lg bg-zinc-800 text-white text-sm font-medium' : 'flex-1 py-2.5 rounded-lg text-zinc-400 text-sm font-medium';
      document.getElementById('authLoginForm').classList.toggle('hidden', tab!=='login');
      document.getElementById('authRegisterForm').classList.toggle('hidden', tab!=='register');
    }
    async function doLogin(){
      const email = document.getElementById('loginEmail').value.trim();
      const password = document.getElementById('loginPassword').value;
      const errEl = document.getElementById('loginError');
      errEl.classList.add('hidden');
      if(!email||!password){errEl.textContent='Email and password required'; errEl.classList.remove('hidden'); return}
      const res = await fetch('/api/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'include',body:JSON.stringify({email,password})});
      const data = await res.json();
      if(!res.ok){errEl.textContent=data.error||'Login failed'; errEl.classList.remove('hidden'); return}
      authToken = data.user.api_token;
      localStorage.setItem('sipra_token', authToken);
      currentUser = data.user;
      closeAuth();
      showToast(`Welcome ${currentUser.name} · ${currentUser.role}`, 'success');
      await checkAuth();
      showDashboard();
    }
    async function doRegister(){
      const name = document.getElementById('regName').value.trim();
      const email = document.getElementById('regEmail').disabled ? document.getElementById('regEmail').value.trim() : document.getElementById('regEmail').value.trim();
      const password = document.getElementById('regPassword').value;
      const errEl = document.getElementById('regError');
      errEl.classList.add('hidden');
      if(!name||!email||!password){errEl.textContent='All fields required'; errEl.classList.remove('hidden'); return}
      const payload = {name,email,password};
      if(inviteTokenFromUrl) payload.invite_token = inviteTokenFromUrl;
      const res = await fetch('/api/auth/register',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'include',body:JSON.stringify(payload)});
      const data = await res.json();
      if(!res.ok){errEl.textContent=data.error||'Register failed'; errEl.classList.remove('hidden'); return}
      authToken = data.user.api_token;
      localStorage.setItem('sipra_token', authToken);
      currentUser = data.user;
      closeAuth();
      showToast(`Account created · ${currentUser.role} · Tenant: ${currentUser.client_name||'Master'}`, 'success');
      inviteTokenFromUrl = null;
      document.getElementById('regEmail').disabled = false;
      await checkAuth();
      showDashboard();
    }
    async function doLogout(){
      await fetch('/api/auth/logout',{method:'POST',headers:getHeaders(),credentials:'include'});
      authToken = null;
      localStorage.removeItem('sipra_token');
      currentUser = null;
      currentTenant = null;
      updateAuthUI();
      showLanding();
      showToast('Logged out', 'info');
      openAuth('login');
    }
    async function checkAuth(){
      const data = await fetchJSON('/api/auth/me');
      if(data && data.authenticated){
        currentUser = data.user;
        authToken = data.user.api_token;
        localStorage.setItem('sipra_token', authToken);
        // if user has client_id, set currentTenant to that client's tenant
        if(data.tenant){
          currentTenant = data.tenant;
        } else if(data.user.client_id){
          // fetch tenant
          const t = await fetchJSON(`/api/tenants/${data.user.client_id}`);
          if(t) currentTenant = t;
        }
        // check URL tenant param overrides? Only for owner
        const urlTenantSlug = parseUrl();
        if(urlTenantSlug && currentUser.role==='owner'){
          const t = allTenants.find(x=>x.slug===urlTenantSlug) || await fetchJSON(`/api/tenants?`); // fallback
          // try fetch by slug via list
          if(!currentTenant || currentTenant.slug!==urlTenantSlug){
            const tenants = await fetchJSON('/api/tenants');
            if(tenants){
              const found = tenants.find(x=>x.slug===urlTenantSlug);
              if(found) currentTenant = found;
            }
          }
        }
        updateAuthUI();
        applyWhiteLabel();
        return true;
      } else {
        currentUser = null;
        updateAuthUI();
        return false;
      }
    }
    function updateAuthUI(){
      const isAuth = !!currentUser;
      document.getElementById('authButtons').classList.toggle('hidden', isAuth);
      document.getElementById('userMenu').classList.toggle('hidden', !isAuth);
      document.getElementById('userMenu').classList.toggle('flex', isAuth);
      document.getElementById('tenantSwitcher').classList.toggle('hidden', !isAuth);
      document.getElementById('tenantSwitcher').classList.toggle('flex', isAuth);
      if(isAuth){
        document.getElementById('userAvatar').src = currentUser.avatar || `https://i.pravatar.cc/150?u=${currentUser.email}`;
        document.getElementById('dashUserAvatar').src = currentUser.avatar || `https://i.pravatar.cc/150?u=${currentUser.email}`;
        document.getElementById('previewUserName').textContent = currentUser.name.split(' ')[0];
        document.getElementById('dashUserName').textContent = currentUser.name.split(' ')[0];
        document.getElementById('sidebarUserRole').textContent = currentUser.role;
      }
      // tenant UI
      if(currentTenant){
        document.getElementById('tenantBadge').textContent = `${currentTenant.name} · /portal/${currentTenant.slug}`;
        document.getElementById('tenantBadge').classList.remove('hidden');
        document.getElementById('tenantBadge').classList.add('inline-flex');
        document.getElementById('currentTenantName').textContent = currentTenant.name;
        document.getElementById('currentTenantLogo').textContent = currentTenant.name[0];
        document.getElementById('currentTenantLogo').style.background = currentTenant.color_primary;
        document.getElementById('dashCurrentTenantName').textContent = currentTenant.name;
        document.getElementById('dashCurrentTenantLogo').textContent = currentTenant.name[0];
        document.getElementById('dashCurrentTenantLogo').style.background = currentTenant.color_primary;
        document.getElementById('dashTopTenant').textContent = `Live 24/7 · ${currentTenant.name} · ${currentTenant.custom_domain||currentTenant.domain} · White-Label: ${currentTenant.hide_sipra_branding?'Yes':'No'}`;
        document.getElementById('sidebarTenantName').textContent = currentTenant.name;
        document.getElementById('sidebarTenantSlug').textContent = currentTenant.slug;
        document.getElementById('dashTenantName').textContent = currentTenant.name;
        document.getElementById('dashTenantSlug').textContent = currentTenant.slug;
        document.getElementById('studioTenantName').textContent = currentTenant.name;
        document.getElementById('leadsTenantName').textContent = currentTenant.name;
        document.getElementById('previewTenantInfo').textContent = `${currentTenant.name} · ${currentTenant.plan} · ${currentTenant.hide_sipra_branding?'White-Label':''}`;
      } else {
        document.getElementById('tenantBadge').classList.add('hidden');
        document.getElementById('currentTenantName').textContent = 'SIPRA Global';
        document.getElementById('dashCurrentTenantName').textContent = 'SIPRA Global';
      }
    }
    function applyWhiteLabel(){
      // If currentTenant has hide_sipra_branding true, hide SIPRA branding elements
      const isWhiteLabel = currentTenant && currentTenant.hide_sipra_branding;
      document.querySelectorAll('.sipra-branding').forEach(el=>{
        if(isWhiteLabel) el.classList.add('white-label-hidden');
        else el.classList.remove('white-label-hidden');
      });
      if(isWhiteLabel && currentTenant){
        // Update logos and colors
        document.getElementById('landingLogo').style.background = currentTenant.color_primary;
        document.getElementById('landingLogo').textContent = currentTenant.name[0];
        document.getElementById('dashLogo').style.background = currentTenant.color_primary;
        document.getElementById('dashLogo').textContent = currentTenant.name[0];
        document.getElementById('dashMobileTitle').textContent = currentTenant.name;
        // Update page title
        document.title = `${currentTenant.name} | Client Portal`;
      } else {
        document.getElementById('landingLogo').style.background = '#4f46e5';
        document.getElementById('landingLogo').textContent = 'S';
        document.getElementById('dashLogo').style.background = '#4f46e5';
        document.getElementById('dashLogo').textContent = 'S';
        document.title = 'SIPRA AI Social Workforce | Your AI Social Media Team — Working 24/7';
      }
      // Apply custom CSS if any
      let styleEl = document.getElementById('customTenantStyle');
      if(!styleEl){styleEl=document.createElement('style'); styleEl.id='customTenantStyle'; document.head.appendChild(styleEl);}
      if(currentTenant && currentTenant.custom_css){
        styleEl.textContent = currentTenant.custom_css;
      } else {
        styleEl.textContent = '';
      }
    }

    // TENANT SWITCHER
    async function openTenantSwitcher(){
      const modal = document.getElementById('tenantSwitcherModal');
      modal.classList.remove('hidden');
      const tenants = await fetchJSON('/api/tenants');
      if(!tenants) return;
      allTenants = tenants;
      document.getElementById('tenantSwitcherList').innerHTML = tenants.map(t=>`
        <button onclick="switchTenant('${t.slug}')" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-zinc-800 text-left transition ${currentTenant && currentTenant.slug===t.slug?'bg-zinc-800 border border-zinc-700':''}">
          <span class="w-8 h-8 rounded-lg flex items-center justify-center text-white text-xs font-bold" style="background:${t.color_primary}">${t.name[0]}</span>
          <div class="flex-1"><div class="text-sm text-white font-medium">${t.name}</div><div class="text-[11px] text-zinc-500">${t.slug} · ${t.custom_domain||t.domain} · ${t.plan} ${t.hide_sipra_branding?'· White-Label':''} · ${t.workspaces} ws</div></div>
          ${currentTenant && currentTenant.slug===t.slug?'<span class="text-[10px] px-2 py-1 rounded-full bg-indigo-600 text-white">Active</span>':''}
        </button>
      `).join('');
    }
    function closeTenantSwitcher(){document.getElementById('tenantSwitcherModal').classList.add('hidden');}
    async function switchTenant(slug){
      closeTenantSwitcher();
      if(!slug){
        currentTenant = null;
        // clear query param
        const url = new URL(window.location);
        url.searchParams.delete('tenant');
        url.searchParams.delete('portal');
        window.history.pushState({}, '', url);
      } else {
        const tenant = allTenants.find(t=>t.slug===slug);
        if(tenant){
          currentTenant = tenant;
          const url = new URL(window.location);
          url.searchParams.set('tenant', slug);
          window.history.pushState({}, '', url);
        }
      }
      updateAuthUI();
      applyWhiteLabel();
      // reload data with tenant filter
      loadStats(); loadLeads(); loadPosts(); loadApprovals(); loadSocial(); loadInbox(); loadAutomations(); loadBrand(); loadAnalytics();
      showToast(`Switched to ${currentTenant?currentTenant.name:'Master Workspace (All)'}`, 'success');
    }

    // CREATE TENANT
    function openCreateTenantModal(){document.getElementById('createTenantModal').classList.remove('hidden');}
    function closeCreateTenantModal(){document.getElementById('createTenantModal').classList.add('hidden');}
    async function createTenant(){
      const name = document.getElementById('newTenantName').value.trim();
      if(!name){showToast('Name required','error'); return}
      const payload = {
        name,
        slug: document.getElementById('newTenantSlug').value.trim() || undefined,
        plan: document.getElementById('newTenantPlan').value,
        custom_domain: document.getElementById('newTenantCustomDomain').value.trim() || null,
        color_primary: document.getElementById('newTenantColorText').value || document.getElementById('newTenantColor').value,
        logo: document.getElementById('newTenantLogo').value.trim() || undefined,
        hide_sipra_branding: document.getElementById('newTenantHideBranding').checked,
        domain: `${(document.getElementById('newTenantSlug').value.trim() || name.toLowerCase().replace(/\s+/g,'-'))}.com`
      };
      const res = await fetch('/api/tenants',{method:'POST',headers:getHeaders(),body:JSON.stringify(payload)});
      const data = await res.json();
      if(!res.ok){showToast(data.error||'Failed to create','error'); return}
      closeCreateTenantModal();
      showToast(`Tenant created: ${data.name} · /portal/${data.slug}`, 'success');
      loadTenants(); loadWorkspaces();
      // auto switch
      currentTenant = data;
      updateAuthUI();
      applyWhiteLabel();
    }

    // WORKSPACES
    function openCreateWorkspaceModal(){
      document.getElementById('createWorkspaceModal').classList.remove('hidden');
      // populate tenant select
      fetchJSON('/api/tenants').then(tenants=>{
        if(!tenants) return;
        document.getElementById('newWsTenant').innerHTML = tenants.map(t=>`<option value="${t.id}" ${currentTenant && currentTenant.id===t.id?'selected':''}>${t.name}</option>`).join('');
      });
    }
    function closeCreateWorkspaceModal(){document.getElementById('createWorkspaceModal').classList.add('hidden');}
    async function createWorkspace(){
      const name = document.getElementById('newWsName').value.trim();
      const tenantId = document.getElementById('newWsTenant').value;
      if(!name||!tenantId){showToast('Name and tenant required','error'); return}
      const res = await fetch(`/api/tenants/${tenantId}/workspaces`,{method:'POST',headers:getHeaders(),body:JSON.stringify({name})});
      const data = await res.json();
      if(!res.ok){showToast(data.error||'Failed','error'); return}
      closeCreateWorkspaceModal();
      showToast(`Workspace created: ${data.name}`, 'success');
      loadWorkspaces();
    }

    // INVITES
    function openInviteModal(){
      document.getElementById('inviteModal').classList.remove('hidden');
      fetchJSON('/api/tenants').then(tenants=>{
        if(!tenants) return;
        document.getElementById('inviteTenant').innerHTML = tenants.map(t=>`<option value="${t.id}" ${currentTenant && currentTenant.id===t.id?'selected':''}>${t.name}</option>`).join('');
      });
    }
    function closeInviteModal(){document.getElementById('inviteModal').classList.add('hidden');}
    async function sendInvite(){
      const email = document.getElementById('inviteEmail').value.trim();
      const role = document.getElementById('inviteRole').value;
      const tenantId = document.getElementById('inviteTenant').value;
      if(!email||!tenantId){showToast('Email and tenant required','error'); return}
      const res = await fetch(`/api/tenants/${tenantId}/invitations`,{method:'POST',headers:getHeaders(),body:JSON.stringify({email,role})});
      const data = await res.json();
      if(!res.ok){showToast(data.error||'Failed','error'); return}
      closeInviteModal();
      showToast(`Invite sent to ${email} · Link: /invite/${data.token.slice(0,12)}...`, 'success');
      loadInvites();
    }

    // DATA LOADERS (tenant-aware)
    async function loadStats(){
      const url = currentTenant ? `/api/stats?tenant=${currentTenant.slug}` : '/api/stats';
      const stats = await fetchJSON(url);
      if(!stats) return;
      document.getElementById('statTotalPosts').textContent = stats.content_pipeline.total;
      document.getElementById('statScheduled').textContent = stats.content_pipeline.scheduled;
      document.getElementById('statPublished').textContent = stats.content_pipeline.published;
      document.getElementById('statPending').textContent = stats.content_pipeline.pending;
      document.getElementById('statNewLeads').textContent = stats.inbound_leads.new;
      document.getElementById('statQualified').textContent = stats.inbound_leads.qualified;
      document.getElementById('statActiveEmp').textContent = stats.ai_workforce.active;
      document.getElementById('statTasks').textContent = (stats.ai_workforce.tasks_completed||0).toLocaleString()+'+';
      document.getElementById('statSignals').textContent = stats.inbound_leads.signals_captured;
      document.getElementById('previewDbStats').textContent = `DB: ${stats.content_pipeline.total} posts · ${stats.inbound_leads.total} leads · Tenant: ${currentTenant?currentTenant.slug:'all'}`;
      document.getElementById('dashTotalPosts').textContent = stats.content_pipeline.total;
      document.getElementById('dashScheduled').textContent = stats.content_pipeline.scheduled;
      document.getElementById('dashPublished').textContent = stats.content_pipeline.published;
      document.getElementById('dashPending').textContent = stats.content_pipeline.pending;
      document.getElementById('dashNewLeads').textContent = stats.inbound_leads.new;
      document.getElementById('dashQualified').textContent = stats.inbound_leads.qualified;
      document.getElementById('dashActiveEmp').textContent = stats.ai_workforce.active;
      document.getElementById('dashTasks').textContent = (stats.ai_workforce.tasks_completed||0).toLocaleString()+'+';
      document.getElementById('dashSignals').textContent = stats.inbound_leads.signals_captured;
      document.getElementById('dashProposal').textContent = '2';
      document.getElementById('dashDbCount').textContent = stats.content_pipeline.total + stats.inbound_leads.total + stats.ai_workforce.total;
      document.getElementById('navLeadsCount').textContent = stats.inbound_leads.new + ' NEW';
      document.getElementById('navApprovalCount').textContent = stats.pending_approvals;
      document.getElementById('navWorkforceCount').textContent = stats.ai_workforce.total;
      document.getElementById('sidebarActiveCount').textContent = stats.ai_workforce.active;
      document.getElementById('previewWorkforceText').textContent = `${stats.ai_workforce.active} digital employees are active`;
      document.getElementById('dashWorkforceText').textContent = `${stats.ai_workforce.active} digital employees are active`;
    }

    async function loadEmployees(){
      const emps = await fetchJSON('/api/employees');
      if(!emps) return;
      const active = emps.filter(e=>e.status==='active').slice(0,4);
      const avatarsHTML = active.map(e=>`<img src="${e.avatar}" class="w-6 h-6 rounded-full border-2 border-zinc-900"/>`).join('') + `<div class="w-6 h-6 rounded-full bg-zinc-800 border-2 border-zinc-900 flex items-center justify-center text-[10px]">+${emps.length-4}</div>`;
      document.getElementById('previewAvatars').innerHTML = avatarsHTML;
      document.getElementById('dashAvatars').innerHTML = avatarsHTML;
      document.getElementById('previewEmployeesGrid').innerHTML = active.map(e=>`
        <div class="p-4 rounded-2xl bg-zinc-900 border border-zinc-800">
          <div class="flex gap-3"><img src="${e.avatar}" class="w-10 h-10 rounded-xl object-cover"/><div class="flex-1"><div class="text-sm font-semibold text-white">${e.name}</div><div class="text-[11px] text-indigo-400">${e.role}</div><div class="mt-2 text-[11px] text-zinc-400 leading-relaxed line-clamp-2">${e.description}</div><div class="mt-3 flex justify-between items-center"><span class="text-[11px] font-mono text-zinc-500">Tasks: <b class="text-zinc-300">${e.tasks}</b></span><span class="text-[10px] px-2 py-1 rounded-full bg-emerald-950/50 text-emerald-400 border border-emerald-900/50">${e.status}</span></div></div></div>
        </div>
      `).join('');
      document.getElementById('dashEmployeesGrid').innerHTML = active.map(e=>`
        <div class="group p-5 rounded-2xl bg-zinc-900 border border-zinc-800 hover:border-zinc-700 transition cursor-pointer">
          <div class="flex gap-3"><img src="${e.avatar}" class="w-11 h-11 rounded-xl object-cover"/><div class="flex-1 min-w-0"><div class="flex items-center justify-between"><div class="text-sm font-semibold text-white truncate">${e.name}</div><span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-950/50 text-emerald-400 border border-emerald-900/50 font-mono">${e.status}</span></div><div class="text-[11px] text-indigo-400 font-medium">${e.role}</div><div class="mt-2 text-[11px] text-zinc-400 leading-relaxed line-clamp-3">${e.description}</div><div class="mt-3 flex justify-between items-center"><span class="text-[11px] font-mono text-zinc-500">Tasks: <b class="text-zinc-300">${e.tasks}</b></span><button onclick="runEmployee(${e.id})" class="text-[11px] px-2.5 py-1 rounded-lg bg-zinc-800 text-zinc-300 group-hover:bg-zinc-700 transition">Run Now</button></div></div></div>
        </div>
      `).join('');
      document.getElementById('workforceGrid').innerHTML = emps.map(e=>`
        <div class="p-5 rounded-2xl bg-zinc-900 border border-zinc-800 hover:border-zinc-700 transition"><div class="flex gap-3"><img src="${e.avatar}" class="w-12 h-12 rounded-xl object-cover"/><div class="flex-1"><div class="flex items-center justify-between"><div class="text-sm font-bold text-white">${e.name}</div><span class="text-[10px] px-2 py-0.5 rounded-full ${e.status==='active'?'bg-emerald-950/50 text-emerald-400 border border-emerald-900/50':'bg-zinc-800 text-zinc-400'} font-mono">${e.status}</span></div><div class="text-xs text-indigo-400">${e.role}</div><div class="text-[11px] text-zinc-500 font-mono mt-1">${e.specialization} · ${e.model}</div><p class="text-xs text-zinc-400 mt-2 leading-relaxed">${e.description}</p><div class="mt-3 flex justify-between items-center"><span class="text-xs font-mono text-zinc-500">Tasks: <b class="text-white">${e.tasks}</b> · ${e.uptime}</span><button onclick="runEmployee(${e.id})" class="px-3 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs">Run</button></div></div></div></div>
      `).join('');
    }

    async function loadLeads(){
      const filter = document.getElementById('leadsFilter')?.value || '';
      let url = '/api/leads';
      const params = new URLSearchParams();
      if(filter) params.set('status', filter);
      if(currentTenant) params.set('tenant', currentTenant.slug);
      if(params.toString()) url += '?' + params.toString();
      const leads = await fetchJSON(url);
      if(!leads) return;
      document.getElementById('previewLeads').innerHTML = leads.slice(0,3).map(l=>`
        <div class="flex justify-between items-center"><div><div class="text-xs text-white">${l.name}</div><div class="text-[11px] text-zinc-500">${l.company}</div></div><div class="text-right"><div class="text-xs text-white">${l.score}/100</div><div class="text-[10px] ${l.status==='qualified'?'text-emerald-400':l.status==='proposal'?'text-amber-400':'text-zinc-400'}">${l.status}</div></div></div>
      `).join('');
      document.getElementById('dashLeadsList').innerHTML = leads.slice(0,3).map(l=>`
        <div class="flex justify-between items-center p-3 rounded-xl bg-zinc-950 border border-zinc-800 hover:border-zinc-700 transition cursor-pointer"><div><div class="text-xs font-medium text-white">${l.name}</div><div class="text-[11px] text-zinc-500">${l.company}</div><div class="text-[10px] text-zinc-600 mt-1">${l.intent_signal}</div></div><div class="text-right"><div class="text-xs font-bold text-white">${l.score}/100</div><div class="text-[10px] px-2 py-0.5 rounded-full bg-zinc-800 text-zinc-300 font-mono mt-1">${l.status}</div></div></div>
      `).join('');
      document.getElementById('leadsGrid').innerHTML = leads.map(l=>`
        <div class="p-4 rounded-2xl bg-zinc-900 border border-zinc-800 hover:border-zinc-700 transition"><div class="flex justify-between items-start mb-2"><div class="flex gap-2"><img src="${l.avatar}" class="w-8 h-8 rounded-full"/><div><div class="text-sm font-semibold text-white">${l.name}</div><div class="text-[11px] text-zinc-500">${l.company} ${l.client_name?`· ${l.client_name}`:''}</div></div></div><span class="text-xs font-bold text-white">${l.score}</span></div><div class="text-[11px] text-zinc-400 mt-2">${l.intent_signal}</div><div class="mt-3 flex justify-between items-center"><span class="text-[10px] px-2 py-1 rounded-full ${l.status==='qualified'?'bg-emerald-950/50 text-emerald-400 border border-emerald-900/50':l.status==='proposal'?'bg-indigo-950/50 text-indigo-300 border border-indigo-900/50':'bg-zinc-800 text-zinc-400'}">${l.status}</span><span class="text-[10px] font-mono text-zinc-500">${new Date(l.created_at).toLocaleDateString()}</span></div></div>
      `).join('');
    }

    async function loadApprovals(){
      let url = '/api/approvals?status=all';
      if(currentTenant) url += `&tenant=${currentTenant.slug}`;
      const approvals = await fetchJSON(url);
      if(!approvals) return;
      const pending = approvals.filter(a=>a.status==='pending');
      document.getElementById('previewApproval').innerHTML = pending.length ? `
        <div class="flex items-center justify-between mb-3"><div class="text-sm font-semibold text-white">Pending Approvals (${pending.length})</div><span class="text-[10px] font-mono px-2 py-1 rounded-full bg-amber-950/50 text-amber-300 border border-amber-900/50">Queue</span></div>
        <div class="p-3 rounded-xl bg-zinc-950 border border-zinc-800"><div class="text-xs font-medium text-white leading-snug">${pending[0].title}</div><div class="text-[10px] font-mono text-zinc-500 mt-1">Level ${pending[0].level} · By: ${pending[0].author_name} ${pending[0].client_name?`· ${pending[0].client_name}`:''}</div><div class="mt-3 text-[11px] text-zinc-400 leading-relaxed line-clamp-3">${pending[0].content}</div><div class="mt-3 flex gap-2"><button onclick="handleApproval(${pending[0].id},'publish')" class="flex-1 py-2 rounded-xl bg-white text-zinc-900 text-xs font-semibold">Publish Now</button><button onclick="handleApproval(${pending[0].id},'approve')" class="flex-1 py-2 rounded-xl bg-zinc-800 text-zinc-300 text-xs">Review</button></div></div>
      ` : `<div class="text-xs text-zinc-500">No pending approvals for ${currentTenant?currentTenant.name:'all tenants'}</div>`;
      document.getElementById('dashApprovalSection').innerHTML = document.getElementById('previewApproval').innerHTML;
      document.getElementById('approvalsGrid').innerHTML = approvals.map(a=>`
        <div class="p-4 rounded-2xl bg-zinc-900 border border-zinc-800"><div class="flex justify-between"><div class="text-sm font-semibold text-white">${a.title}</div><span class="text-[10px] px-2 py-1 rounded-full ${a.status==='pending'?'bg-amber-950/50 text-amber-300':'bg-emerald-950/50 text-emerald-300'}">${a.status}</span></div><div class="text-[11px] text-zinc-500 mt-1">Level ${a.level} · ${a.author_name} ${a.client_name?`· ${a.client_name}`:''} · ${new Date(a.created_at).toLocaleDateString()}</div><div class="text-xs text-zinc-400 mt-2">${a.content.slice(0,200)}...</div><div class="mt-3 flex gap-2"><button onclick="handleApproval(${a.id},'publish')" class="px-3 py-1.5 rounded-lg bg-white text-zinc-900 text-xs">Publish</button><button onclick="handleApproval(${a.id},'approve')" class="px-3 py-1.5 rounded-lg bg-zinc-800 text-zinc-300 text-xs">Approve</button><button onclick="handleApproval(${a.id},'reject')" class="px-3 py-1.5 rounded-lg bg-zinc-800 text-zinc-300 text-xs">Reject</button></div></div>
      `).join('');
    }

    async function loadPosts(){
      let url = '/api/posts';
      if(currentTenant) url += `?tenant=${currentTenant.slug}`;
      const posts = await fetchJSON(url);
      if(!posts) return;
      document.getElementById('studioPostsList').innerHTML = posts.map(p=>`
        <div class="p-4 rounded-2xl bg-zinc-900 border border-zinc-800 hover:border-zinc-700 transition"><div class="flex justify-between items-start"><div><div class="text-sm font-semibold text-white">${p.title}</div><div class="text-[11px] text-zinc-500 mt-1">${p.platform} · ${p.status} · Level ${p.approval_level} · by ${p.author_name||'System'} ${p.client_name?`· ${p.client_name}`:''}</div></div><span class="text-[10px] px-2 py-1 rounded-full ${p.status==='published'?'bg-emerald-950/50 text-emerald-400':p.status==='scheduled'?'bg-indigo-950/50 text-indigo-300':p.status==='pending'?'bg-amber-950/50 text-amber-300':'bg-zinc-800 text-zinc-400'}">${p.status}</span></div><div class="text-xs text-zinc-400 mt-2 line-clamp-2">${p.content.slice(0,180)}...</div><div class="mt-3 text-[11px] font-mono text-zinc-500">Created: ${new Date(p.created_at).toLocaleDateString()} · Engagement: ${p.engagement}</div></div>
      `).join('');
      const cal = document.getElementById('calendarGrid');
      if(cal){
        const days = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
        cal.innerHTML = days.map(d=>`<div class="text-[10px] font-mono text-zinc-500 p-2">${d}</div>`).join('') + Array.from({length:30},(_,i)=>{
          const dayPosts = posts.filter(p=>p.scheduled_at && new Date(p.scheduled_at).getDate()===i+1);
          return `<div class="min-h-[80px] p-2 rounded-xl bg-zinc-900 border border-zinc-800"><div class="text-[11px] text-zinc-400">${i+1}</div>${dayPosts.map(p=>`<div class="mt-1 text-[10px] px-1.5 py-0.5 rounded bg-indigo-950/50 text-indigo-300 truncate">${p.title.slice(0,15)}</div>`).join('')}</div>`;
        }).join('');
      }
      // workspace select
      if(currentTenant){
        const ws = await fetchJSON(`/api/tenants/${currentTenant.id}/workspaces`);
        if(ws){
          document.getElementById('newPostWorkspace').innerHTML = '<option value="">Select Workspace (optional)</option>' + ws.map(w=>`<option value="${w.id}">${w.name}</option>`).join('');
        }
      }
    }

    async function loadTenants(){
      const tenants = await fetchJSON('/api/tenants');
      if(!tenants) return;
      allTenants = tenants;
      document.getElementById('navAgencyCount').textContent = tenants.length;
      document.getElementById('previewTenants').innerHTML = tenants.slice(0,4).map(t=>`
        <div class="flex items-center gap-2 p-2 rounded-xl bg-zinc-950 border border-zinc-800"><span class="w-6 h-6 rounded-lg flex items-center justify-center text-white text-[10px] font-bold" style="background:${t.color_primary}">${t.name[0]}</span><div class="flex-1 min-w-0"><div class="text-xs text-white truncate">${t.name}</div><div class="text-[10px] text-zinc-500 truncate">${t.slug} · ${t.custom_domain||t.domain}</div></div><span class="text-[10px] px-1.5 py-0.5 rounded bg-zinc-800 text-zinc-400">${t.plan}</span></div>
      `).join('');
      document.getElementById('agencyGrid').innerHTML = tenants.map(t=>`
        <div class="p-5 rounded-2xl bg-zinc-900 border border-zinc-800 hover:border-zinc-700 transition group">
          <div class="flex gap-3"><img src="${t.logo}" class="w-10 h-10 rounded-xl"/><div class="flex-1"><div class="flex items-center justify-between"><div class="text-sm font-bold text-white">${t.name}</div><span class="w-2 h-2 rounded-full ${t.status==='active'?'bg-emerald-400':'bg-red-400'}"></span></div><div class="text-xs text-zinc-500">${t.domain} ${t.custom_domain?`→ ${t.custom_domain}`:''}</div><div class="text-[11px] text-zinc-500 mt-1">${t.slug} · ${t.workspaces} workspaces · ${t.monthly_posts} posts/mo · ${t.plan}</div></div><div class="w-3 h-3 rounded-full" style="background:${t.color_primary}"></div></div>
          <div class="mt-3 grid grid-cols-2 gap-2 text-[11px]">
            <div class="p-2 rounded-lg bg-zinc-950 border border-zinc-800"><div class="text-zinc-500">Portal URL</div><div class="text-indigo-400 font-mono">/portal/${t.slug}</div></div>
            <div class="p-2 rounded-lg bg-zinc-950 border border-zinc-800"><div class="text-zinc-500">Custom Domain</div><div class="text-zinc-300 font-mono truncate">${t.custom_domain||'—'}</div></div>
          </div>
          <div class="mt-3 flex gap-2"><button onclick="switchTenant('${t.slug}')" class="flex-1 py-2 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs">Switch to Tenant</button><button onclick="editTenant(${t.id})" class="flex-1 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs">Edit Portal</button></div>
          <div class="mt-2 flex gap-2 text-[10px]"><span class="px-2 py-1 rounded-full ${t.hide_sipra_branding?'bg-emerald-950/50 text-emerald-300 border border-emerald-900/50':'bg-zinc-800 text-zinc-400'}">${t.hide_sipra_branding?'White-Label: Yes':'White-Label: No'}</span><span class="px-2 py-1 rounded-full bg-zinc-800 text-zinc-400">${t.workspaces} ws</span></div>
        </div>
      `).join('');
    }

    async function loadWorkspaces(){
      const tenants = await fetchJSON('/api/tenants');
      if(!tenants) return;
      let allWs = [];
      for(let t of tenants){
        const ws = await fetchJSON(`/api/tenants/${t.id}/workspaces`);
        if(ws) allWs = allWs.concat(ws.map(w=>({...w, tenant_name:t.name, tenant_slug:t.slug, tenant_color:t.color_primary})));
      }
      document.getElementById('navWorkspaceCount').textContent = allWs.length;
      document.getElementById('sidebarWorkspaceCount').textContent = allWs.length;
      document.getElementById('workspacesGrid').innerHTML = allWs.map(w=>`
        <div class="p-5 rounded-2xl bg-zinc-900 border border-zinc-800"><div class="flex gap-3"><span class="w-8 h-8 rounded-lg flex items-center justify-center text-white text-xs font-bold" style="background:${w.tenant_color}">${w.tenant_name[0]}</span><div class="flex-1"><div class="text-sm font-bold text-white">${w.name}</div><div class="text-xs text-zinc-500">${w.tenant_name} · ${w.slug} ${w.is_default?'<span class="ml-1 px-1.5 py-0.5 rounded bg-indigo-600 text-white text-[10px]">Default</span>':''}</div><div class="text-[11px] text-zinc-600 mt-1">${w.description||''}</div></div></div><div class="mt-3 text-[10px] font-mono text-zinc-500">ID: ${w.id} · Tenant: ${w.tenant_slug} · Created ${new Date(w.created_at).toLocaleDateString()}</div></div>
      `).join('');
    }

    async function loadClientUsers(){
      const tenants = await fetchJSON('/api/tenants');
      if(!tenants) return;
      let allUsers = [];
      for(let t of tenants){
        const users = await fetchJSON(`/api/tenants/${t.id}/users`);
        if(users) allUsers = allUsers.concat(users);
      }
      // also include global users without client_id
      const globalUsers = await fetchJSON('/api/tenants'); // already have
      document.getElementById('clientUsersGrid').innerHTML = allUsers.map(u=>`
        <div class="p-4 rounded-2xl bg-zinc-900 border border-zinc-800 flex gap-3"><img src="${u.avatar}" class="w-10 h-10 rounded-xl"/><div class="flex-1"><div class="text-sm font-semibold text-white">${u.name}</div><div class="text-xs text-zinc-500">${u.email} · ${u.role}</div><div class="text-[11px] text-zinc-600">${u.client_name||'Master'} · Last login ${u.last_login?new Date(u.last_login).toLocaleDateString():'never'}</div></div><span class="w-2 h-2 rounded-full ${u.is_active?'bg-emerald-400':'bg-red-400'}"></span></div>
      `).join('');
    }

    async function loadInvites(){
      const tenants = await fetchJSON('/api/tenants');
      if(!tenants) return;
      let allInvites = [];
      for(let t of tenants){
        const invs = await fetchJSON(`/api/tenants/${t.id}/invitations`);
        if(invs) allInvites = allInvites.concat(invs);
      }
      document.getElementById('invitesGrid').innerHTML = allInvites.map(inv=>`
        <div class="p-4 rounded-2xl bg-zinc-900 border border-zinc-800 flex justify-between items-center"><div><div class="text-sm text-white">${inv.email} → ${inv.client_name}</div><div class="text-[11px] text-zinc-500">${inv.role} · ${inv.status} · Expires ${new Date(inv.expires_at).toLocaleDateString()} · Token ${inv.token.slice(0,12)}...</div><div class="text-[10px] font-mono text-indigo-400 mt-1">${inv.invite_link}</div></div><span class="text-[10px] px-2 py-1 rounded-full ${inv.status==='pending'?'bg-amber-950/50 text-amber-300':'bg-zinc-800 text-zinc-400'}">${inv.status}</span></div>
      `).join('');
    }

    async function loadSocial(){
      let url = '/api/social-accounts';
      if(currentTenant) url += `?tenant=${currentTenant.slug}`;
      const accounts = await fetchJSON(url);
      if(!accounts) return;
      document.getElementById('socialGrid').innerHTML = accounts.map(a=>`
        <div class="p-4 rounded-2xl bg-zinc-900 border border-zinc-800 flex items-center gap-3"><div class="w-10 h-10 rounded-xl bg-zinc-800 flex items-center justify-center text-zinc-400 font-bold text-xs">${a.platform[0].toUpperCase()}</div><div class="flex-1"><div class="text-sm font-semibold text-white">${a.display_name} ${a.client_id?`· ${currentTenant?currentTenant.name:''}`:''}</div><div class="text-xs text-zinc-500">@${a.username} · ${a.followers.toLocaleString()} followers · ${a.engagement_rate}% eng</div></div><span class="w-2 h-2 rounded-full ${a.connected?'bg-emerald-400':'bg-red-400'}"></span></div>
      `).join('');
    }

    async function loadInbox(){
      let url = '/api/inbox';
      if(currentTenant) url += `?tenant=${currentTenant.slug}`;
      const msgs = await fetchJSON(url);
      if(!msgs) return;
      document.getElementById('inboxGrid').innerHTML = msgs.map(m=>`
        <div class="p-4 rounded-2xl bg-zinc-900 border border-zinc-800"><div class="flex gap-3"><img src="${m.sender_avatar}" class="w-8 h-8 rounded-full"/><div class="flex-1"><div class="flex justify-between"><div class="text-sm font-semibold text-white">${m.sender_name}</div><span class="text-[11px] px-2 py-0.5 rounded-full bg-zinc-800 text-zinc-400">${m.platform}</span></div><div class="text-xs text-zinc-500">${m.sender_handle} · Intent ${m.intent_score}/100</div><div class="text-sm text-zinc-300 mt-2">${m.message}</div>${m.response?`<div class="mt-2 p-2 rounded-lg bg-zinc-950 border border-zinc-800 text-xs text-zinc-400">Reply: ${m.response}</div>`:''}<div class="mt-2 flex gap-2"><button onclick="replyInbox(${m.id})" class="px-3 py-1 rounded-lg bg-indigo-600 text-white text-xs">Reply</button><span class="text-[10px] px-2 py-1 rounded-full bg-zinc-800 text-zinc-400">${m.status}</span></div></div></div></div>
      `).join('');
    }

    async function loadAutomations(){
      let url = '/api/automations';
      if(currentTenant) url += `?tenant=${currentTenant.slug}`;
      const autos = await fetchJSON(url);
      if(!autos) return;
      document.getElementById('automationsGrid').innerHTML = autos.map(a=>`
        <div class="p-5 rounded-2xl bg-zinc-900 border border-zinc-800"><div class="flex justify-between"><div class="text-sm font-semibold text-white">${a.name}</div><button onclick="toggleAuto(${a.id})" class="w-10 h-5 rounded-full ${a.active?'bg-indigo-600':'bg-zinc-700'} relative transition"><span class="absolute top-0.5 w-4 h-4 rounded-full bg-white transition-all ${a.active?'left-5':'left-0.5'}"></span></button></div><div class="text-xs text-zinc-400 mt-1">${a.description}</div><div class="text-[11px] font-mono text-zinc-500 mt-2">Trigger: ${a.trigger} · Action: ${a.action} · Runs: ${a.runs}</div></div>
      `).join('');
    }

    async function loadBrand(){
      let url = '/api/brand-dna';
      if(currentTenant) url += `?tenant=${currentTenant.slug}`;
      const dna = await fetchJSON(url);
      if(!dna) return;
      document.getElementById('brandGrid').innerHTML = dna.map(d=>`
        <div class="p-4 rounded-2xl bg-zinc-900 border border-zinc-800"><div class="text-[11px] font-mono text-indigo-400 uppercase">${d.category}</div><div class="text-sm font-semibold text-white mt-1">${d.key}</div><div class="text-xs text-zinc-400 mt-1">${d.value}</div></div>
      `).join('');
    }

    async function loadAnalytics(){
      let url = '/api/analytics?days=7';
      if(currentTenant) url += `&tenant=${currentTenant.slug}`;
      const data = await fetchJSON(url);
      document.getElementById('analyticsGrid').innerHTML = `<div class="text-xs text-zinc-400">Loaded ${data?data.length:0} analytics snapshots for ${currentTenant?currentTenant.name:'all tenants'} · /api/analytics?tenant=${currentTenant?currentTenant.slug:'all'}<br/><br/>${data?data.slice(0,5).map(d=>`${d.date} ${d.platform}: ${d.followers} followers, ${d.engagement} eng, ${d.leads} leads`).join('<br/>'):''}</div>`;
    }

    async function loadAudit(){
      const logs = await fetchJSON('/api/audit-logs');
      if(!logs) return;
      document.getElementById('auditGrid').innerHTML = logs.map(l=>`
        <div class="p-3 rounded-xl bg-zinc-900 border border-zinc-800 flex justify-between items-center"><div><div class="text-xs text-white">${l.action} ${l.resource} ${l.resource_id?`#${l.resource_id}`:''}</div><div class="text-[11px] text-zinc-500">User ${l.user_id} · Client ${l.client_id||'global'} · ${l.details} · IP ${l.ip_address}</div></div><div class="text-[10px] font-mono text-zinc-500">${new Date(l.created_at).toLocaleString()}</div></div>
      `).join('');
    }

    // Actions
    async function runEmployee(id){
      const res = await fetch(`/api/employees/${id}/run`,{method:'POST',headers:getHeaders()});
      const data = await res.json();
      if(res.ok){showToast(`${data.employee.name} ran task · Total ${data.employee.tasks}`, 'success'); loadEmployees(); loadStats();}
      else showToast(data.error||'Failed','error');
    }
    async function handleApproval(id,action){
      const res = await fetch(`/api/approvals/${id}/action`,{method:'POST',headers:getHeaders(),body:JSON.stringify({action})});
      const data = await res.json();
      if(res.ok){showToast(`Approval ${action}ed`, 'success'); loadApprovals(); loadPosts(); loadStats();}
      else showToast(data.error||'Failed','error');
    }
    async function createPost(){
      const title = document.getElementById('newPostTitle').value;
      const content = document.getElementById('newPostContent').value;
      const platform = document.getElementById('newPostPlatform').value;
      const workspace_id = document.getElementById('newPostWorkspace').value || null;
      if(!title||!content){showToast('Title and content required','error'); return}
      const payload = {title,content,platform,status:'draft',author_id:2, workspace_id: workspace_id?parseInt(workspace_id):null};
      if(currentTenant) payload.client_id = currentTenant.id;
      const res = await fetch('/api/posts',{method:'POST',headers:getHeaders(),body:JSON.stringify(payload)});
      if(res.ok){document.getElementById('newPostTitle').value=''; document.getElementById('newPostContent').value=''; showToast('Draft created','success'); loadPosts(); loadStats();}
      else{const d=await res.json(); showToast(d.error||'Failed','error');}
    }
    async function runRepurpose(){
      const source = document.getElementById('repurposeSource').value;
      if(!source){showToast('Paste content first','error'); return}
      document.getElementById('repurposeResult').innerHTML = '<div class="text-zinc-400 animate-pulse">Repurposing with Leo Thorne (AI Repurposing Specialist)... Tenant: '+(currentTenant?currentTenant.name:'Master')+'</div>';
      const res = await fetch('/api/repurpose',{method:'POST',headers:getHeaders(),body:JSON.stringify({source})});
      const data = await res.json();
      if(!res.ok){document.getElementById('repurposeResult').innerHTML = `<div class="text-red-400">${data.error}</div>`; return}
      document.getElementById('repurposeResult').innerHTML = `
        <div class="space-y-4 text-left"><div><div class="text-xs font-mono text-zinc-500 uppercase mb-1">LinkedIn Post</div><div class="p-3 rounded-xl bg-zinc-950 border border-zinc-800 text-xs text-zinc-300">${data.linkedin}</div></div><div><div class="text-xs font-mono text-zinc-500 uppercase mb-1">Instagram (${data.instagram.length})</div><div class="space-y-1">${data.instagram.map(t=>`<div class="p-2 rounded-lg bg-zinc-950 border border-zinc-800 text-xs text-zinc-400">${t}</div>`).join('')}</div></div><div><div class="text-xs font-mono text-zinc-500 uppercase mb-1">X Tweets (${data.x.length})</div><div class="space-y-1">${data.x.map(t=>`<div class="p-2 rounded-lg bg-zinc-950 border border-zinc-800 text-xs text-zinc-400">${t}</div>`).join('')}</div></div><div><div class="text-xs font-mono text-zinc-500 uppercase mb-1">Viral Hooks (${data.hooks.length})</div><div class="grid grid-cols-2 gap-1">${data.hooks.map(h=>`<div class="p-2 rounded-lg bg-zinc-950 border border-zinc-800 text-[11px] text-zinc-400">${h}</div>`).join('')}</div></div><div class="pt-2 text-[11px] font-mono text-emerald-400">✓ ${data.total_assets} assets generated · Tenant: ${currentTenant?currentTenant.name:'Master'}</div></div>
      `;
      loadPosts(); loadStats();
    }
    async function toggleAuto(id){await fetch(`/api/automations/${id}/toggle`,{method:'POST',headers:getHeaders()}); loadAutomations();}
    async function replyInbox(id){const reply=prompt('Enter reply (Brand DNA will be enforced):'); if(!reply) return; await fetch(`/api/inbox/${id}/reply`,{method:'POST',headers:getHeaders(),body:JSON.stringify({response:reply})}); loadInbox(); showToast('Reply sent','success');}
    function runPrompt(){document.getElementById('repurposeSource').value = "Create next week's LinkedIn and Instagram content for my business - SIPRA Marketing helps agencies automate social media with AI employees"; switchTab('repurpose'); setTimeout(()=>runRepurpose(),300);}
    async function handleSearch(q){
      if(!q||q.length<2){document.getElementById('searchResults').innerHTML='<div class="p-4 text-xs text-zinc-500">Type to search employees, posts, leads... Tenant-aware</div>'; return}
      let url = `/api/search?q=${encodeURIComponent(q)}`;
      if(currentTenant) url += `&tenant=${currentTenant.slug}`;
      const results = await fetchJSON(url);
      const container = document.getElementById('searchResults');
      if(!results||results.length===0){container.innerHTML='<div class="p-4 text-xs text-zinc-500">No results</div>'; return}
      container.innerHTML = results.map(r=>`<button onclick="switchTab('${r.url}'); closeSearch()" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-zinc-800 text-left"><span class="w-8 h-8 rounded-lg bg-zinc-800 text-zinc-400 flex items-center justify-center text-xs">${r.type[0].toUpperCase()}</span><div><div class="text-sm text-white">${r.title}</div><div class="text-[11px] text-zinc-500">${r.subtitle}</div></div></button>`).join('');
    }
    function editTenant(id){showToast('Edit tenant modal — use Agency Hub API PUT /api/tenants/'+id,'info'); switchTab('agency');}

    function switchTab(tab){
      document.querySelectorAll('.tab-content').forEach(el=>el.classList.add('hidden'));
      const target = document.getElementById('tab-'+tab);
      if(target) target.classList.remove('hidden');
      document.querySelectorAll('.tab-link').forEach(el=>{el.classList.remove('bg-zinc-900','text-white','border','border-zinc-800'); el.classList.add('text-zinc-400'); if(el.dataset.tab===tab){el.classList.add('bg-zinc-900','text-white'); el.classList.remove('text-zinc-400');}});
      if(tab==='workforce') loadEmployees();
      if(tab==='studio') loadPosts();
      if(tab==='leads') loadLeads();
      if(tab==='approvals') loadApprovals();
      if(tab==='social') loadSocial();
      if(tab==='inbox') loadInbox();
      if(tab==='automations') loadAutomations();
      if(tab==='brand') loadBrand();
      if(tab==='agency') loadTenants();
      if(tab==='workspaces') loadWorkspaces();
      if(tab==='clients') loadClientUsers();
      if(tab==='invites') loadInvites();
      if(tab==='calendar') loadPosts();
      if(tab==='analytics') loadAnalytics();
      if(tab==='audit') loadAudit();
    }

    async function handleLaunchDashboard(){
      const ok = await checkAuth();
      if(!ok){openAuth('login'); return}
      showDashboard();
    }
    function showDashboard(){
      document.getElementById('landingView').classList.add('hidden');
      document.getElementById('dashboardView').classList.remove('hidden');
      document.getElementById('dashboardView').classList.add('flex');
      window.scrollTo(0,0);
      showToast(`Dashboard Launched · Tenant: ${currentTenant?currentTenant.name:'Master'} · ${currentUser?currentUser.role:''}`, 'success');
      loadStats(); loadEmployees(); loadLeads(); loadApprovals(); loadPosts(); loadTenants();
    }
    function showLanding(){
      document.getElementById('dashboardView').classList.add('hidden');
      document.getElementById('dashboardView').classList.remove('flex');
      document.getElementById('landingView').classList.remove('hidden');
      window.scrollTo(0,0);
    }
    function openSearch(){document.getElementById('commandPalette').classList.remove('hidden'); setTimeout(()=>document.getElementById('searchInput').focus(),50); document.getElementById('searchResults').innerHTML='<div class="p-4 text-xs text-zinc-500">Type to search... Tenant-aware search</div>';}
    function closeSearch(){document.getElementById('commandPalette').classList.add('hidden');}
    function openOnboarding(){document.getElementById('onboardingModal').classList.remove('hidden');}
    function closeOnboarding(){document.getElementById('onboardingModal').classList.add('hidden');}
    function showToast(msg,type){
      const container = document.getElementById('toastContainer') || (()=>{const d=document.createElement('div');d.id='toastContainer';d.className='fixed bottom-4 right-4 z-50 space-y-2 max-w-sm pointer-events-none';document.body.appendChild(d);return d;})();
      const el=document.createElement('div');
      el.className=`p-3.5 rounded-xl border shadow-xl flex items-start gap-2.5 text-xs pointer-events-auto ${type==='success'?'bg-emerald-950/95 border-emerald-700/80 text-emerald-100':'bg-zinc-900/95 border-zinc-700 text-zinc-100'}`;
      el.innerHTML=`<span class="shrink-0 mt-0.5">${type==='success'?'✓':'•'}</span><div class="flex-1 leading-snug">${msg}</div><button onclick="this.parentElement.remove()" class="text-zinc-400 hover:text-white p-0.5">✕</button>`;
      container.appendChild(el);
      setTimeout(()=>el.remove(),4000);
    }
    window.addEventListener('keydown', (e)=>{
      if((e.metaKey||e.ctrlKey) && e.key.toLowerCase()==='k'){e.preventDefault();openSearch();}
      if(e.key==='Escape'){closeSearch();closeOnboarding();closeTenantSwitcher();closeCreateTenantModal();closeCreateWorkspaceModal();closeInviteModal();}
    });
    // Color picker sync
    document.getElementById('newTenantColor')?.addEventListener('input', (e)=>{document.getElementById('newTenantColorText').value=e.target.value;});
    document.getElementById('newTenantColorText')?.addEventListener('input', (e)=>{document.getElementById('newTenantColor').value=e.target.value;});
    document.getElementById('newTenantName')?.addEventListener('input', (e)=>{const slug=e.target.value.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,50); document.getElementById('newTenantSlug').value=slug;});

    window.addEventListener('DOMContentLoaded', async ()=>{
      parseUrl();
      const isAuth = await checkAuth();
      if(!isAuth){
        // show landing but auth modal after 1s for demo
        setTimeout(()=>{if(!currentUser) openAuth('login');}, 800);
      }
      loadStats(); loadEmployees(); loadLeads(); loadApprovals(); loadTenants();
      fetch('/api/health').then(r=>r.json()).then(d=>{console.log('Health',d); document.getElementById('dashboardDbIndicator').innerHTML=`<span class="w-1 h-1 rounded-full bg-emerald-400"></span>DB: ${d.tenants} tenants · ${d.users} users · ${d.workspaces} ws · ${d.employees} emp`;});
    });
  </script>

  <!-- Onboarding Modal -->
  <div id="onboardingModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" onclick="closeOnboarding()"></div>
    <div class="relative w-full max-w-md rounded-2xl bg-zinc-900 border border-zinc-800 shadow-2xl p-6">
      <div class="flex items-center justify-between mb-6"><h3 class="text-sm font-semibold text-white">7-Step Onboarding Wizard — Multi-Tenant</h3><button onclick="closeOnboarding()" class="w-7 h-7 rounded-lg bg-zinc-800 flex items-center justify-center text-zinc-400 hover:text-white">✕</button></div>
      <div class="space-y-4">
        <div class="flex gap-3"><div class="w-6 h-6 rounded-full bg-indigo-600 text-white flex items-center justify-center text-xs font-bold">1</div><div><div class="text-sm text-white font-medium">Auth Setup — Owner + Client Users</div><div class="text-xs text-zinc-500">users table with password_hash, api_token, client_id FK, roles: owner/admin/agency_owner/client_admin/client_user</div></div></div>
        <div class="flex gap-3"><div class="w-6 h-6 rounded-full bg-zinc-800 text-zinc-400 flex items-center justify-center text-xs">2</div><div><div class="text-sm text-zinc-400">Create Tenants — White-Label Portals</div><div class="text-xs text-zinc-600">agency_clients with slug, custom_domain, color_primary, logo, hide_sipra_branding, /portal/:slug</div></div></div>
        <div class="flex gap-3"><div class="w-6 h-6 rounded-full bg-zinc-800 text-zinc-400 flex items-center justify-center text-xs">3</div><div><div class="text-sm text-zinc-400">Workspaces + Tenant Isolation</div><div class="text-xs text-zinc-600">workspaces table per tenant, all tables have client_id FK, filtered by X-Tenant-Slug or ?tenant=</div></div></div>
        <div class="flex gap-3"><div class="w-6 h-6 rounded-full bg-zinc-800 text-zinc-400 flex items-center justify-center text-xs">4</div><div><div class="text-sm text-zinc-400">Invite Client Users</div><div class="text-xs text-zinc-600">invitations table with token, /invite/:token, auto-assign client_id and role</div></div></div>
        <div class="pt-4"><button onclick="handleLaunchDashboard(); closeOnboarding()" class="w-full py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold transition">Start Onboarding →</button></div>
      </div>
    </div>
  </div>
</body>
</html>
