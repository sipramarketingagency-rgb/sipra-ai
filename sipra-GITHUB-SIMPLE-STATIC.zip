<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SIPRA AI Social Workforce | Your AI Social Media Team — Working 24/7</title>
  <meta name="description" content="SIPRA AI Social Workforce — Deploy specialized AI employees 24/7 for social media strategy, multi-platform publishing, inbox management, and lead generation." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="./assets/original.css">
  <style>
    body{font-family:"Plus Jakarta Sans",system-ui,sans-serif;background:#09090b;color:#fafafa;overflow-x:hidden}
    .font-mono{font-family:"JetBrains Mono",monospace}
    .animate-spin-slow{animation:spin 3s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}
    .glass{backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}
    ::-webkit-scrollbar{width:6px;height:6px}
    ::-webkit-scrollbar-track{background:transparent}
    ::-webkit-scrollbar-thumb{background:rgba(161,161,170,.3);border-radius:9999px}
    .white-label-hidden{display:none!important}
  </style>
</head>
<body class="min-h-screen bg-zinc-950 text-zinc-100 selection:bg-indigo-500 selection:text-white">
  <!-- AUTH MODAL -->
  <div id="authModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/90 backdrop-blur-md"></div>
    <div class="relative w-full max-w-md rounded-[20px] bg-zinc-900 border border-zinc-800 shadow-2xl overflow-hidden">
      <div class="p-8">
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-bold">S</div>
          <div><div class="text-sm font-bold text-white">SIPRA</div><div class="text-[10px] font-mono text-zinc-500">AI SOCIAL WORKFORCE</div></div>
          <span class="ml-auto px-2.5 py-1 rounded-full bg-emerald-950/50 border border-emerald-800/50 text-[10px] font-mono text-emerald-300">Secure Auth</span>
        </div>

        <div class="flex gap-2 p-1 rounded-xl bg-zinc-950 border border-zinc-800 mb-6">
          <button id="authTabLogin" onclick="switchAuthTab('login')" class="flex-1 py-2.5 rounded-lg bg-zinc-800 text-white text-sm font-medium">Login</button>
          <button id="authTabRegister" onclick="switchAuthTab('register')" class="flex-1 py-2.5 rounded-lg text-zinc-400 text-sm font-medium">Register</button>
        </div>

        <div id="authLoginForm" class="space-y-4">
          <div>
            <label class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider mb-1.5 block">Email</label>
            <input id="loginEmail" type="email" placeholder="farrukhzulfiqarahmed13@gmail.com" class="w-full px-4 py-3 rounded-xl bg-zinc-950 border border-zinc-800 text-sm text-white placeholder:text-zinc-600 outline-none focus:border-indigo-500 transition"/>
          </div>
          <div>
            <label class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider mb-1.5 block">Password</label>
            <input id="loginPassword" type="password" placeholder="••••••••" class="w-full px-4 py-3 rounded-xl bg-zinc-950 border border-zinc-800 text-sm text-white placeholder:text-zinc-600 outline-none focus:border-indigo-500 transition"/>
          </div>
          <div class="p-3 rounded-xl bg-indigo-950/30 border border-indigo-900/50 text-[11px] text-indigo-300">
            <div class="font-medium text-white mb-1">Demo Accounts (Seeded):</div>
            <div>Owner: farrukhzulfiqarahmed13@gmail.com / Sipra@2026!</div>
            <div>Admin: admin@sipra.marketing / Admin@123</div>
            <div>Client: rachel@vancescale.com / Client@123</div>
          </div>
          <button onclick="doLogin()" class="w-full py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold shadow-lg shadow-indigo-600/20 transition">Sign In →</button>
          <div id="loginError" class="hidden p-3 rounded-xl bg-red-950/50 border border-red-900/50 text-xs text-red-300"></div>
        </div>

        <div id="authRegisterForm" class="hidden space-y-4">
          <div>
            <label class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider mb-1.5 block">Full Name</label>
            <input id="regName" type="text" placeholder="Farrukh Zulfiqar Ahmed" class="w-full px-4 py-3 rounded-xl bg-zinc-950 border border-zinc-800 text-sm text-white placeholder:text-zinc-600 outline-none focus:border-indigo-500 transition"/>
          </div>
          <div>
            <label class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider mb-1.5 block">Email</label>
            <input id="regEmail" type="email" placeholder="you@agency.com" class="w-full px-4 py-3 rounded-xl bg-zinc-950 border border-zinc-800 text-sm text-white placeholder:text-zinc-600 outline-none focus:border-indigo-500 transition"/>
          </div>
          <div>
            <label class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider mb-1.5 block">Password</label>
            <input id="regPassword" type="password" placeholder="••••••••" class="w-full px-4 py-3 rounded-xl bg-zinc-950 border border-zinc-800 text-sm text-white placeholder:text-zinc-600 outline-none focus:border-indigo-500 transition"/>
          </div>
          <div id="inviteInfo" class="hidden p-3 rounded-xl bg-amber-950/30 border border-amber-900/50 text-xs text-amber-200"></div>
          <button onclick="doRegister()" class="w-full py-3.5 rounded-xl bg-white hover:bg-zinc-100 text-zinc-900 text-sm font-semibold transition">Create Account →</button>
          <div id="regError" class="hidden p-3 rounded-xl bg-red-950/50 border border-red-900/50 text-xs text-red-300"></div>
        </div>

        <div class="mt-6 pt-6 border-t border-zinc-800 text-center">
          <div class="text-[11px] text-zinc-500">Protected by Brand DNA Guardrails · 99.8% Uptime · Multi-Tenant Isolation</div>
        </div>
      </div>
    </div>
  </div>

  <!-- LANDING VIEW -->
  <div id="landingView" class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-40 w-full border-b border-zinc-900 bg-zinc-950/80 glass">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div id="landingLogo" class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-bold text-sm">S</div>
          <div class="flex flex-col sipra-branding">
            <span class="text-sm font-bold tracking-tight text-white leading-none">SIPRA</span>
            <span class="text-[10px] font-mono text-zinc-400 tracking-wider leading-none mt-0.5">AI SOCIAL WORKFORCE</span>
          </div>
          <span class="hidden md:inline-flex ml-4 items-center gap-2 px-2.5 py-1 rounded-full bg-emerald-950/50 border border-emerald-800/50 text-[10px] font-mono text-emerald-300">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>Live 24/7
          </span>
          <span id="tenantBadge" class="hidden ml-2 items-center gap-2 px-2.5 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-[10px] font-mono text-zinc-400"></span>
        </div>
        <div class="flex items-center gap-2">
          <button onclick="openSearch()" class="hidden sm:flex items-center gap-2 px-3 py-2 rounded-xl bg-zinc-900 border border-zinc-800 text-xs text-zinc-400 hover:text-zinc-200 transition">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <span>Search</span>
            <span class="ml-2 px-1.5 py-0.5 rounded bg-zinc-800 border border-zinc-700 text-[10px]">⌘K</span>
          </button>
          <div id="authButtons" class="flex items-center gap-2">
            <button onclick="openAuth('login')" class="px-4 py-2.5 bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-200 rounded-xl text-xs font-semibold transition">Sign In</button>
            <button onclick="openAuth('register')" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-semibold shadow-lg shadow-indigo-600/20 transition">Get Started</button>
          </div>
          <div id="userMenu" class="hidden items-center gap-3">
            <div id="tenantSwitcher" class="hidden md:flex items-center gap-2 px-3 py-2 rounded-xl bg-zinc-900 border border-zinc-800 text-xs text-zinc-300 cursor-pointer hover:bg-zinc-800 transition" onclick="openTenantSwitcher()">
              <span class="w-6 h-6 rounded-lg bg-indigo-600 flex items-center justify-center text-white text-[10px] font-bold" id="currentTenantLogo">S</span>
              <span id="currentTenantName">SIPRA Global</span>
              <svg class="w-3 h-3 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </div>
            <img id="userAvatar" src="" class="w-8 h-8 rounded-xl object-cover border border-zinc-800"/>
            <button onclick="doLogout()" class="w-8 h-8 rounded-xl bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-400 hover:text-white transition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            </button>
          </div>
        </div>
      </div>
    </header>

    <section class="relative py-20 sm:py-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-center overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-indigo-600/10 rounded-full blur-[140px] pointer-events-none"></div>
      <div class="relative z-10">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-950/80 border border-indigo-800/60 text-indigo-300 text-xs font-mono font-medium mb-8">
          <svg class="w-3.5 h-3.5 text-indigo-400 animate-spin-slow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          <span>Next-Generation Autonomous Marketing SaaS · Multi-Tenant + Auth</span>
        </div>
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-white max-w-4xl mx-auto leading-[1.1]">
          The Autonomous <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-purple-300 to-indigo-500">AI Social Media</span> Workforce
        </h1>
        <p class="mt-6 text-base sm:text-lg text-zinc-400 max-w-2xl mx-auto leading-relaxed">
          Deploy 24/7 digital employees for platform-native content creation, omni-channel scheduling, inbox response triage, lead scoring, and <span class="text-white font-medium">multi-tenant agency client management with white-label portals</span>.
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <button onclick="handleLaunchDashboard()" class="px-6 py-3.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-sm font-semibold flex items-center gap-2 shadow-xl shadow-indigo-600/30 transition-all hover:scale-102">
            Launch Unified Dashboard
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </button>
          <button onclick="openOnboarding()" class="px-6 py-3.5 bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-200 rounded-xl text-sm font-semibold flex items-center gap-2 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            Run 7-Step Onboarding Wizard
          </button>
        </div>
        <div class="mt-8 p-4 rounded-2xl bg-zinc-900/50 border border-zinc-800 max-w-2xl mx-auto text-left">
          <div class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider mb-2">🔐 Auth + Multi-Tenant Features Added</div>
          <div class="grid grid-cols-2 gap-2 text-xs text-zinc-400">
            <div class="flex items-center gap-1.5"><span class="w-1 h-1 rounded-full bg-emerald-400"></span> JWT + Session Auth</div>
            <div class="flex items-center gap-1.5"><span class="w-1 h-1 rounded-full bg-emerald-400"></span> 6 Tenants + 21 Workspaces</div>
            <div class="flex items-center gap-1.5"><span class="w-1 h-1 rounded-full bg-emerald-400"></span> White-Label Portals /portal/:slug</div>
            <div class="flex items-center gap-1.5"><span class="w-1 h-1 rounded-full bg-emerald-400"></span> Custom Domains + Colors</div>
            <div class="flex items-center gap-1.5"><span class="w-1 h-1 rounded-full bg-emerald-400"></span> Client Invites + Roles</div>
            <div class="flex items-center gap-1.5"><span class="w-1 h-1 rounded-full bg-emerald-400"></span> Tenant Isolation + Audit Logs</div>
          </div>
        </div>
        <div class="mt-12 pt-8 border-t border-zinc-800/60 flex flex-wrap items-center justify-center gap-8 text-xs text-zinc-400">
          <span class="flex items-center gap-1.5"><span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span> Powered by Gemini 3.8 Flash</span>
          <span class="flex items-center gap-1.5"><span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span> Multi-Tenant Agency Portals</span>
          <span class="flex items-center gap-1.5"><span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span> Human-in-the-Loop Governance</span>
          <span class="flex items-center gap-1.5"><span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span> Inbound CRM Lead Pipeline</span>
        </div>
      </div>
    </section>

    <section class="px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full pb-16">
      <div class="rounded-[20px] border border-zinc-800 bg-zinc-900/50 p-2 sm:p-3 shadow-2xl">
        <div class="rounded-[14px] overflow-hidden border border-zinc-800 bg-zinc-950">
          <div class="h-12 border-b border-zinc-800 bg-zinc-950 flex items-center justify-between px-4">
            <div class="flex items-center gap-2 text-xs font-mono text-zinc-500">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Live 24/7 Digital Operations · SIPRA Global (Master Workspace) · <span id="previewDbStats" class="text-zinc-400">DB Synced</span> · <span id="previewTenantInfo" class="text-indigo-400">Multi-Tenant</span>
            </div>
            <div class="flex items-center gap-1">
              <div class="w-3 h-3 rounded-full bg-zinc-800"></div>
              <div class="w-3 h-3 rounded-full bg-zinc-800"></div>
              <div class="w-3 h-3 rounded-full bg-zinc-800"></div>
            </div>
          </div>
          <div class="p-6 sm:p-8 bg-[#09090b]">
            <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 mb-8">
              <div>
                <h2 class="text-2xl font-bold text-white">Good morning, <span id="previewUserName">Farrukh</span>.</h2>
                <p class="text-sm text-zinc-400 mt-1"><span class="text-white font-medium">Your AI workforce is ready.</span> <span id="previewWorkforceText">8 digital employees are active</span>, monitoring conversations, preparing platform-native content, and converting comment signals into qualified CRM leads.</p>
              </div>
              <div class="flex gap-2">
                <button onclick="openSearch()" class="px-4 py-2 rounded-xl bg-zinc-900 border border-zinc-800 text-xs font-medium text-zinc-300">Ask Your AI Workforce</button>
                <button onclick="handleLaunchDashboard()" class="px-4 py-2 rounded-xl bg-white text-zinc-950 text-xs font-semibold">Create Content</button>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
              <div class="p-4 rounded-2xl bg-zinc-900 border border-zinc-800">
                <div class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider mb-2">Content Pipeline</div>
                <div class="text-2xl font-bold text-white"><span id="statTotalPosts">0</span><span class="text-sm font-normal text-zinc-500 ml-1">total posts</span></div>
                <div class="mt-3 flex gap-2 text-[11px]">
                  <span class="px-2 py-1 rounded-full bg-zinc-800 text-zinc-300">Scheduled: <b id="statScheduled">0</b></span>
                  <span class="px-2 py-1 rounded-full bg-zinc-800 text-zinc-300">Published: <b id="statPublished">0</b></span>
                  <span class="px-2 py-1 rounded-full bg-amber-950/50 border border-amber-900/50 text-amber-300">Pending: <b id="statPending">0</b></span>
                </div>
              </div>
              <div class="p-4 rounded-2xl bg-zinc-900 border border-zinc-800">
                <div class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider mb-2 flex justify-between">Social Growth <span class="text-emerald-400">+18.4% 30d Velocity</span></div>
                <div class="text-2xl font-bold text-white">+12.4%<span class="text-sm font-normal text-zinc-500 ml-1">Followers</span></div>
                <div class="mt-1 text-xs text-zinc-400">Engagement: <span class="text-white font-medium">+8.7%</span></div>
                <div class="mt-3 h-1.5 w-full bg-zinc-800 rounded-full overflow-hidden"><div class="h-full w-[72%] bg-indigo-500 rounded-full"></div></div>
              </div>
              <div class="p-4 rounded-2xl bg-zinc-900 border border-zinc-800">
                <div class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider mb-2 flex justify-between">Inbound Leads <span class="text-zinc-400"><span id="statSignals">4</span> signals captured</span></div>
                <div class="text-2xl font-bold text-white"><span id="statNewLeads">0</span><span class="text-sm font-normal text-zinc-500 ml-1">New</span></div>
                <div class="mt-1 text-xs text-zinc-400">Qualified: <span class="text-emerald-400 font-medium" id="statQualified">0</span></div>
                <div class="mt-3 flex gap-1"><div class="h-1.5 w-8 bg-emerald-500 rounded-full"></div><div class="h-1.5 w-8 bg-zinc-700 rounded-full"></div><div class="h-1.5 w-8 bg-zinc-700 rounded-full"></div></div>
              </div>
              <div class="p-4 rounded-2xl bg-zinc-900 border border-zinc-800">
                <div class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider mb-2">AI Workforce</div>
                <div class="text-2xl font-bold text-white"><span id="statActiveEmp">0</span><span class="text-sm font-normal text-zinc-500 ml-1">employees active</span></div>
                <div class="mt-1 text-xs text-zinc-400">Tasks completed: <span class="text-white font-medium" id="statTasks">0</span> 99.8% Uptime</div>
                <div class="mt-3 flex -space-x-2" id="previewAvatars"></div>
              </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
              <div class="lg:col-span-8">
                <div class="flex items-center justify-between mb-4">
                  <h3 class="font-semibold text-white">Active AI Employees</h3>
                  <span class="text-xs text-zinc-500 font-mono hidden sm:inline">Autonomous specialists · employees table</span>
                  <button onclick="handleLaunchDashboard()" class="text-xs text-indigo-400">View All 10 Employees</button>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" id="previewEmployeesGrid"></div>
              </div>
              <div class="lg:col-span-4 space-y-4">
                <div class="p-4 rounded-2xl bg-zinc-900 border border-zinc-800">
                  <div class="text-xs font-mono text-zinc-500 mb-3">Try: "Create next week's LinkedIn and Instagram content for my business"</div>
                  <div class="text-[11px] text-zinc-400 mb-3">Orchestrates Sarah Chen and Alex Rivera to generate 5 multi-platform drafts.</div>
                  <button onclick="handleLaunchDashboard()" class="w-full py-2 rounded-xl bg-indigo-600 text-white text-xs font-medium">Run Prompt</button>
                  <div class="mt-4 pt-4 border-t border-zinc-800" id="previewApproval"></div>
                </div>
                <div class="p-4 rounded-2xl bg-zinc-900 border border-zinc-800">
                  <div class="text-xs font-semibold text-white mb-3">Recent High-Intent Leads <span class="text-[10px] font-mono text-zinc-500 ml-2">leads table · 19 records</span></div>
                  <div class="space-y-3" id="previewLeads"></div>
                </div>
                <div class="p-4 rounded-2xl bg-zinc-900 border border-zinc-800">
                  <div class="text-xs font-semibold text-white mb-3">Multi-Tenant Agencies <span class="text-[10px] font-mono text-zinc-500">6 tenants · white-label</span></div>
                  <div class="space-y-2" id="previewTenants"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <footer class="mt-auto border-t border-zinc-900 py-10 px-4 text-center text-xs text-zinc-500 space-y-2">
      <div class="sipra-branding">SIPRA AI Social Workforce · Developed for SIPRA Marketing & Business Development Services</div>
      <div>Lead Developer: Farrukh Zulfiqar Ahmed (<a href="mailto:farrukhzulfiqarahmed13@gmail.com" class="text-indigo-400 hover:underline">farrukhzulfiqarahmed13@gmail.com</a>) · DB: SQLite <code class="px-1 py-0.5 rounded bg-zinc-900 border border-zinc-800">sipra.db</code> · Backend: Flask + SQLAlchemy · Auth + Multi-Tenant v2.0</div>
