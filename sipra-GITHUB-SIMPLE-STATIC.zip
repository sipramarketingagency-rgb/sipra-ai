    <div class="relative w-full max-w-lg rounded-2xl bg-zinc-900 border border-zinc-800 shadow-2xl p-6 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-6"><h3 class="text-sm font-semibold text-white">New Client Workspace — White-Label Portal</h3><button onclick="closeCreateTenantModal()" class="w-7 h-7 rounded-lg bg-zinc-800 flex items-center justify-center text-zinc-400 hover:text-white"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button></div>
      <div class="space-y-4">
        <div><label class="text-[11px] font-mono text-zinc-500 uppercase">Agency / Client Name *</label><input id="newTenantName" placeholder="Vance Scale Agency" class="w-full mt-1 px-3 py-2.5 rounded-xl bg-zinc-950 border border-zinc-800 text-sm text-white outline-none focus:border-indigo-500"/></div>
        <div class="grid grid-cols-2 gap-3"><div><label class="text-[11px] font-mono text-zinc-500 uppercase">Slug (auto)</label><input id="newTenantSlug" placeholder="vance-scale" class="w-full mt-1 px-3 py-2.5 rounded-xl bg-zinc-950 border border-zinc-800 text-sm text-white outline-none focus:border-indigo-500"/></div><div><label class="text-[11px] font-mono text-zinc-500 uppercase">Plan</label><select id="newTenantPlan" class="w-full mt-1 px-3 py-2.5 rounded-xl bg-zinc-950 border border-zinc-800 text-sm text-white"><option value="starter">Starter</option><option value="pro" selected>Pro</option><option value="enterprise">Enterprise</option><option value="white_label">White-Label</option></select></div></div>
        <div><label class="text-[11px] font-mono text-zinc-500 uppercase">Custom Domain (portal.client.com)</label><input id="newTenantCustomDomain" placeholder="portal.vancescale.com" class="w-full mt-1 px-3 py-2.5 rounded-xl bg-zinc-950 border border-zinc-800 text-sm text-white outline-none focus:border-indigo-500"/><div class="text-[10px] text-zinc-600 mt-1">White-label URL: https://custom_domain → serves /portal/:slug with client branding</div></div>
        <div class="grid grid-cols-2 gap-3"><div><label class="text-[11px] font-mono text-zinc-500 uppercase">Primary Color</label><input id="newTenantColor" type="color" value="#4f46e5" class="w-full mt-1 h-10 rounded-xl bg-zinc-950 border border-zinc-800"/><input id="newTenantColorText" value="#4f46e5" class="w-full mt-2 px-3 py-2 rounded-xl bg-zinc-950 border border-zinc-800 text-sm text-white"/></div><div><label class="text-[11px] font-mono text-zinc-500 uppercase">Logo URL</label><input id="newTenantLogo" placeholder="https://..." class="w-full mt-1 px-3 py-2.5 rounded-xl bg-zinc-950 border border-zinc-800 text-sm text-white outline-none focus:border-indigo-500"/><div class="mt-2 flex items-center gap-2"><input id="newTenantHideBranding" type="checkbox" class="rounded"/><label class="text-xs text-zinc-400">Hide SIPRA branding (white-label)</label></div></div></div>
        <button onclick="createTenant()" class="w-full py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold">Create Tenant + Default Workspace →</button>
        <div class="p-3 rounded-xl bg-zinc-950 border border-zinc-800 text-[11px] text-zinc-500">Creates: agency_clients row with slug, custom_domain, color, logo, hide_branding, plus workspaces row (default). Portal URL: /portal/:slug — isolated data via client_id FK on all tables.</div>
      </div>
    </div>
  </div>

  <!-- CREATE WORKSPACE MODAL -->
  <div id="createWorkspaceModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" onclick="closeCreateWorkspaceModal()"></div>
    <div class="relative w-full max-w-md rounded-2xl bg-zinc-900 border border-zinc-800 shadow-2xl p-6">
      <div class="flex items-center justify-between mb-6"><h3 class="text-sm font-semibold text-white">New Workspace</h3><button onclick="closeCreateWorkspaceModal()" class="w-7 h-7 rounded-lg bg-zinc-800 flex items-center justify-center text-zinc-400 hover:text-white">✕</button></div>
      <div class="space-y-4">
        <div><label class="text-[11px] font-mono text-zinc-500 uppercase">Workspace Name</label><input id="newWsName" placeholder="Client A - Social" class="w-full mt-1 px-3 py-2.5 rounded-xl bg-zinc-950 border border-zinc-800 text-sm text-white outline-none focus:border-indigo-500"/></div>
        <div><label class="text-[11px] font-mono text-zinc-500 uppercase">Client / Tenant</label><select id="newWsTenant" class="w-full mt-1 px-3 py-2.5 rounded-xl bg-zinc-950 border border-zinc-800 text-sm text-white"></select></div>
        <button onclick="createWorkspace()" class="w-full py-3 rounded-xl bg-indigo-600 text-white text-sm font-semibold">Create Workspace</button>
